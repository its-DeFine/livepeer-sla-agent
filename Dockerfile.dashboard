# Lightweight dashboard-only image
FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml .
COPY agent/ ./agent/
COPY dashboard/ ./dashboard/

RUN pip install --no-cache-dir ".[eth]"

RUN mkdir -p /app/data

EXPOSE 8080

ENV DASHBOARD_PORT=8080

CMD ["python", "-c", "import uvicorn; from dashboard.server import create_app; uvicorn.run(create_app(), host='0.0.0.0', port=8080)"]
