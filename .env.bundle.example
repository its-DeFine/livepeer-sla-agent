# Copy to `.env.bundle` and edit values.
#
# Used by:
# - `docker-compose.bundle.yml` (peer-pay + peer-board)
#
# IMPORTANT: never commit real tokens.

# ---- Payments backend (peer-pay) ----
PAYMENTS_API_ADMIN_TOKEN=change-me-admin-token
# Dashboard uses this name for the same token.
PAYMENTS_ADMIN_TOKEN=change-me-admin-token
# Optional: read-only viewer tokens (comma-separated)
# PAYMENTS_VIEWER_TOKENS=viewer-token-1,viewer-token-2

# ---- Dashboard (peer-board) ----
# Shared token that gates `/challenge/*` endpoints on agents (optional but recommended).
# Set the same value on orchestrator agents.
SLA_CHALLENGE_TOKEN=

# ---- Auto verification loop (peer-board) ----
AUTO_VERIFY_ENABLED=1
AUTO_VERIFY_USE_PAYMENTS_OFFERS=true
AUTO_VERIFY_INTERVAL_SECONDS=1800
AUTO_VERIFY_JITTER_FRACTION=0.5
AUTO_VERIFY_ONLY_LINKED=true
AUTO_VERIFY_ONLINE_TIMEOUT_MINUTES=10
AUTO_VERIFY_NODE_COOLDOWN_SECONDS=0
